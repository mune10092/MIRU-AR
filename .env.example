# Supabase connection settings（STEP6では未使用。空のまま）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 公開テストモード（秘密情報ではない）
# true  → Netlify 確認用 /models/demo-public.glb
# 未設定または false → ローカル実測定具 /models/demo.glb
# Netlify では netlify.toml の [build.environment] で true を設定する
NEXT_PUBLIC_MIRU_PUBLIC_TEST=